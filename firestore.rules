rules_version = '2';

// Local development only. The emulator has no real users to protect, and the
// seed script needs unauthenticated writes — do not deploy this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurants/{doc} {
      allow read: if true;
      allow write: if true;
    }
    // Vendor claims. In production: read/write your own doc, admins only for
    // status changes, and nobody may set their own status to approved.
    match /vendors/{uid} {
      allow read, write: if true;
    }

    // Per-user state: favourites, diet flags, points ledger.
    match /users/{uid} {
      allow read, write: if true;
    }

    // Feedback sent from the navbar panel, no account required.
    match /feedback/{id} {
      allow read, write: if true;
    }

    // One document per person per venue per day, written on a verified scan.
    match /scans/{id} {
      allow read, write: if true;
    }

    // Shared photo-lookup cache, written by /api/photo.
    match /photos/{key} {
      allow read, write: if true;
    }

    // Visit counters, incremented by the app on a restaurant page view.
    match /metrics/{restaurantId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
