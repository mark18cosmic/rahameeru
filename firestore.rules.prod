rules_version = '2';

/**
 * Production rules.
 *
 * The sibling `firestore.rules` is the emulator's: it allows everything so the
 * seed script can write unauthenticated. That file must never reach a real
 * project. To deploy these instead, point firebase.json at this file:
 *
 *   "firestore": { "rules": "firestore.rules.prod" }
 *
 * Admins are identified by the email on their auth token, matching
 * `adminEmails()` in app/lib/useVendor.ts. Keep the two lists in step — the
 * client one decides what the UI offers, this one decides what actually
 * happens.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'kaish018@gmail.com'
           ];
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Listings are public to read. Only an admin, or the approved vendor who
    // owns the listing, may write one.
    match /restaurants/{id} {
      function ownsListing() {
        return signedIn()
          && resource.data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/vendors/$(request.auth.uid))
               .data.status == 'approved';
      }
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ownsListing();
    }

    // What the home page shows. Anyone may read it; only an admin sets it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A vendor applies for themselves and may edit their own application, but
    // must never be able to approve it — status and plan are admin-only.
    match /vendors/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.restaurantIds == resource.data.restaurantIds);
      allow delete: if isAdmin();
    }

    // Favourites, diet flags and the points ledger. A user owns their own
    // document; an admin may read every one and adjust roles and points.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin()
        // Nobody grants themselves a role or a balance: those two fields are
        // the admin's to write, and must be unchanged on a self-write.
        || (isSelf(uid)
            && request.resource.data.get('role', 'user')
                 == resource.data.get('role', 'user')
            && request.resource.data.get('suspended', false)
                 == resource.data.get('suspended', false));
      allow delete: if isAdmin();
    }

    // Reviews are public. You may write your own and edit it; the listing's
    // owner may only add a reply, which is enforced in the app and re-checked
    // here by requiring the rest of the document to be untouched.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Feedback from the navbar panel. Anyone may send one without an account —
    // that is the point of it — so this is the one collection open to an
    // unauthenticated write. The shape and length are checked here rather than
    // trusted from the client, and only an admin can read the inbox back.
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.kind in ['idea', 'problem', 'listing', 'praise']
        && request.resource.data.handled == false;
      allow update, delete: if isAdmin();
    }

    // Named lists of places. Public to read, so they can be shared by link;
    // only the owner may change one, and never hand it to someone else.
    match /lists/{id} {
      function validList(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.description is string && d.description.size() <= 280
          && d.restaurantIds is list && d.restaurantIds.size() <= 50;
      }
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['title', 'description', 'restaurantIds', 'ownerId', 'ownerName', 'createdAt', 'updatedAt'])
        && validList(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validList(request.resource.data);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Home page content cards. Guides are the admin's. A special may be
    // written only by the approved owner of that restaurant, only at its one
    // fixed id (so it replaces rather than piles up), and for about a day.
    match /cards/{id} {
      function ownsRestaurant(rid) {
        return signedIn()
          && get(/databases/$(database)/documents/restaurants/$(rid)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.status == 'approved';
      }
      allow read: if true;
      allow create, update: if isAdmin()
        || (request.resource.data.kind == 'special'
            && id == 'special-' + request.resource.data.restaurantId
            && ownsRestaurant(request.resource.data.restaurantId)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 80
            && request.resource.data.expiresAt <= request.time.toMillis() + 25 * 60 * 60 * 1000);
      allow delete: if isAdmin()
        || (resource.data.kind == 'special' && ownsRestaurant(resource.data.restaurantId));
    }

    // Shared "decide together" wheels. No account needed: the unguessable id
    // in the link is the invitation. Once created, the pool is fixed; people
    // may only add their name, their vetoes and a spin result.
    match /wheels/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['poolIds', 'names', 'vetoes', 'createdAt'])
        && request.resource.data.poolIds is list
        && request.resource.data.poolIds.size() >= 2
        && request.resource.data.poolIds.size() <= 30
        && request.resource.data.names is map
        && request.resource.data.names.size() == 1
        && request.resource.data.vetoes is map
        && request.resource.data.createdAt is int;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['names', 'vetoes', 'result'])
        && request.resource.data.names.size() <= 50
        && request.resource.data.vetoes.size() <= 50;
      allow delete: if isAdmin();
    }

    // One document per person per venue per day, written on a verified scan.
    match /scans/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Shared photo-lookup cache. Read by everyone, written by /api/photo.
    match /photos/{key} {
      allow read: if true;
      allow write: if signedIn() || isAdmin();
    }

    // Visit counters, incremented by the app on a restaurant page view.
    match /metrics/{restaurantId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Anything not named above is closed. A new collection has to be granted
    // access deliberately rather than inheriting a blanket allow.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
